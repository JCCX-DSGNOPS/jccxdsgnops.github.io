{
  "$schema": "../schema/component.schema.json",
  "identity": {
    "id": "radio-button",
    "name": "Radio Button",
    "category": "input",
    "status": "stable",
    "version": "1.0.0"
  },
  "purpose": {
    "summary": "Select exactly one option from mutually exclusive choices.",
    "whenToUse": [
      "Select 1 from 2-5 options",
      "All options must be visible"
    ],
    "whenNotToUse": [
      {
        "case": "More than 5 options",
        "useInstead": "dropdown"
      },
      {
        "case": "Multiple selections allowed",
        "useInstead": "checkbox"
      }
    ]
  },
  "anatomy": {
    "parts": [
      {
        "index": 1,
        "id": "circle",
        "name": "Radio Circle",
        "required": true,
        "style": {
          "width": "20px",
          "height": "20px",
          "borderRadius": "50%"
        }
      }
    ]
  },
  "states": {
    "interactionModel": "selectable",
    "list": [
      {
        "id": "unselected",
        "trigger": "Not selected",
        "delta": {}
      },
      {
        "id": "selected",
        "trigger": "User selects",
        "delta": {
          "circle": {
            "background": "--nodo-primary"
          }
        }
      }
    ]
  }
}